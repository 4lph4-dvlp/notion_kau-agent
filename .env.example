# 복사해서 .env 로 저장하고 값을 채운다. .env 는 절대 공유/커밋하지 않는다.

# Figma → Settings → Security → Personal access tokens 에서 발급
# 필요한 스코프: File content = Read
FIGMA_TOKEN=figd_

# design/figma-file.json 의 fileKey 와 항상 같은 값이어야 한다. (README 4.2)
#   경로 A(공유 작업공간에 참여): 아래 값을 그대로 둔다
#   경로 B(내 작업공간을 새로 구성): 내 파일 키로 바꾸고 figma-file.json 도 함께 바꾼다
FIGMA_FILE_KEY=l4iUTnc5fRX9vPDLSY8eDI
